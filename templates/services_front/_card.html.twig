{# Carte d'un service (accueil + page Services). Paramètres : service, index #}
{% set url = path('app_service_show', {slug: service.slug}) %}
<article class="card reveal group" style="--d:{{ ((index|default(1)) - 1) % 3 * 90 }}ms">
  <div class="card-media aspect-[16/10]">
    {% if service.imageUrl %}
      <img src="{{ media(service, 'image', 'card') }}" alt="" width="640" height="400" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover">
    {% else %}
      <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-brand-600 to-brand-900"><i class="las la-tools text-6xl text-white/30" aria-hidden="true"></i></div>
    {% endif %}
    <span class="absolute left-4 top-4 grid h-10 w-10 place-items-center rounded-full bg-white/90 text-sm font-extrabold text-brand-700 backdrop-blur" aria-hidden="true">{{ '%02d'|format(index|default(1)) }}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-gray-900 group-hover:text-brand-700 transition-colors">
      <a href="{{ url }}" class="card-link">{{ service.name }}</a>
    </h3>
    <p class="mt-3 flex-1 text-gray-600 leading-relaxed">{{ service.description|excerpt(140) }}</p>
    <div class="mt-5 flex items-center justify-between">
      <span class="link-arrow">Découvrir <i class="las la-arrow-right" aria-hidden="true"></i></span>
      {% if service.realisations|length %}
        <span class="chip"><i class="las la-hard-hat" aria-hidden="true"></i>{{ service.realisations|length }} projet{{ service.realisations|length > 1 ? 's' }}</span>
      {% endif %}
    </div>
  </div>
</article>
