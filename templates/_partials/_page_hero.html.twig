{#
  Bandeau d'en-tête des pages intérieures.
  Paramètres : title (obligatoire), eyebrow, lead, crumbs (fil d'Ariane), image (URL de fond facultative), actions (bloc HTML brut facultatif)
#}
<section class="page-hero">
  {% if image is defined and image %}
    <img src="{{ image }}" alt="" class="absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-luminosity" fetchpriority="high" decoding="async">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-900/40"></div>
  {% endif %}
  <div class="container-x relative pt-8 pb-16 md:pt-10 md:pb-24">
    {% include '_partials/_breadcrumb.html.twig' with {items: crumbs, light: true} %}
    <div class="max-w-3xl">
      {% if eyebrow is defined and eyebrow %}<p class="eyebrow eyebrow-light mb-4">{{ eyebrow }}</p>{% endif %}
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05] text-white">{{ title }}</h1>
      {% if lead is defined and lead %}<p class="mt-5 text-lg md:text-xl text-brand-100/90 leading-relaxed max-w-2xl">{{ lead }}</p>{% endif %}
      {% if actions is defined and actions %}<div class="mt-8 flex flex-wrap gap-3">{{ actions|raw }}</div>{% endif %}
    </div>
  </div>
</section>
