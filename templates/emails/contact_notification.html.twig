<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><title>Nouveau message</title></head>
<body style="font-family:Arial,Helvetica,sans-serif;color:#1f2937;background:#f3f4f6;margin:0;padding:24px">
  <table role="presentation" width="100%" style="max-width:640px;margin:0 auto;background:#fff;border-radius:8px;overflow:hidden">
    <tr><td style="background:#15803d;color:#fff;padding:20px 24px;font-size:18px;font-weight:bold">
      Nouveau message du site – {{ contact.subjectLabel }}
    </td></tr>
    <tr><td style="padding:24px">
      <table role="presentation" cellpadding="6" style="font-size:14px">
        <tr><td style="color:#6b7280">Nom</td><td><strong>{{ contact.fullName }}</strong></td></tr>
        <tr><td style="color:#6b7280">E-mail</td><td><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></td></tr>
        {% if contact.phone %}<tr><td style="color:#6b7280">Téléphone</td><td><a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ contact.phone }}</a></td></tr>{% endif %}
        {% if contact.organization %}<tr><td style="color:#6b7280">Organisation</td><td>{{ contact.organization }}</td></tr>{% endif %}
        <tr><td style="color:#6b7280">Reçu le</td><td>{{ contact.createdAt|date('d/m/Y à H:i') }}</td></tr>
      </table>
      <div style="margin-top:16px;padding:16px;background:#f9fafb;border-left:4px solid #16a34a;white-space:pre-line;font-size:15px;line-height:1.6">{{ contact.message }}</div>
      <p style="font-size:13px;color:#6b7280;margin-top:20px">Répondez directement à cet e-mail pour écrire à {{ contact.fullName }}.</p>
    </td></tr>
  </table>
</body></html>
