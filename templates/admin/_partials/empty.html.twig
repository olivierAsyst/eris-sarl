{# État vide d'une liste. Paramètres : icon, text, url, label #}
<div class="rounded-2xl border-2 border-dashed border-gray-200 bg-white p-12 text-center">
  <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-brand-50 text-brand-600"><i class="las {{ icon|default('la-folder-open') }} text-3xl" aria-hidden="true"></i></span>
  <p class="mt-4 font-semibold text-gray-800">{{ text|default('Aucun élément pour le moment.') }}</p>
  {% if url is defined %}<a href="{{ url }}" class="btn btn-primary btn-sm mt-5"><i class="las la-plus" aria-hidden="true"></i> {{ label }}</a>{% endif %}
</div>
