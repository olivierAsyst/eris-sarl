{# En-tête de page admin. Paramètres : title, subtitle?, back_url?, back_label?, actions? (HTML) #}
<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    {% if back_url is defined and back_url %}
      <a href="{{ back_url }}" class="mb-2 inline-flex items-center gap-1 text-sm font-semibold text-gray-500 hover:text-brand-700">
        <i class="las la-arrow-left" aria-hidden="true"></i> {{ back_label|default('Retour à la liste') }}
      </a>
    {% endif %}
    <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl">{{ title }}</h1>
    {% if subtitle is defined and subtitle %}<p class="mt-1 text-gray-500">{{ subtitle }}</p>{% endif %}
  </div>
  {% if actions is defined and actions %}<div class="flex shrink-0 flex-wrap gap-2">{{ actions|raw }}</div>{% endif %}
</div>
